+fn run_without_gpui() -> Option<Result<()>> {
+    match std::env::args_os().skip(1).collect::<Vec<_>>().as_slice() {
+        [] => None,
+        [help] if help == "--help" => {
+            println!(
+                "Usage: openlogi-overlay [--stdio]\n\n\
+                 Without options, draws the Actions Ring in its own GPUI window.\n\
+                 --stdio  Serve the ring to an external renderer over JSON Lines on\n\
+                 \x20        stdin/stdout (Linux; requires {}=external).",
+                openlogi_core::env::OVERLAY_BACKEND
+            );
+            Some(Ok(()))
+        }
+        [mode] if mode == "--stdio" => Some(run_stdio()),
+        _ => Some(Err(anyhow::anyhow!("unknown option; see --help"))),
+    }
+}
