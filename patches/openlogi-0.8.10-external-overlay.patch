@@ -0,0 +1,631 @@
+//! The Actions Ring for an external renderer, over a private JSON Lines pipe.
+//!
+//! A parent process — the Omarchy shell — draws the ring on its own
+//! layer-shell surface and speaks to this process over stdin/stdout only. The
+//! parent sees presentation and a session id; the agent still validates and
+//! executes every action, so nothing the parent writes can name one.
+//!
+//! Both pipe ends are switched to non-blocking mode and driven by the runtime,
+//! so no read or write can park a thread past shutdown: a silent parent, a
+//! stalled reader, and a closed pipe all end this process within its deadlines.
+
+use std::collections::BTreeSet;
+use std::os::fd::AsFd as _;
+use std::sync::Arc;
+use std::time::{Duration, Instant};
+
+use anyhow::{Context as _, Result, anyhow, bail};
+use gpui::AssetSource as _;
+use openlogi_core::action_ring::DISPLAY_LIFETIME;
+use openlogi_core::binding::ActionRingSlot;
+use openlogi_ipc::client::Observer;
+use openlogi_ipc::{ActionRingInvocation, AgentSnapshot, InventoryHealth};
+use openlogi_ui::action_icons::ActionIcons;
+use serde::{Deserialize, Serialize};
+use tokio::io::{AsyncBufReadExt as _, AsyncWriteExt as _, BufReader};
+use tokio::net::unix::pipe;
+use tokio::signal::unix::{SignalKind, signal};
+use tokio::sync::{mpsc, watch};
+use tracing::{info, warn};
+
+use crate::ipc::{self, LinkFailure, OverlayCommand};
+use crate::ring::{RADIUS, SLOT_SIZE, WINDOW_SIZE, presentation_label};
+
+/// Version of the line protocol, announced in the first line.
+const PROTOCOL: u32 = 1;
+
+/// Longest command line accepted, newline excluded.
+const MAX_LINE: usize = 4096;
+
+/// How long one stdout write, or the final cancellation, may take.
+const PIPE_DEADLINE: Duration = Duration::from_secs(2);
+
+/// How long to wait between attempts to reach an agent.
+const RETRY_PERIOD: Duration = Duration::from_secs(1);
+
+/// A command from the renderer. Ids travel as decimal strings because a
+/// JavaScript number cannot hold every `u64`.
+#[derive(Debug, Deserialize)]
+#[serde(tag = "type", rename_all = "lowercase", deny_unknown_fields)]
+enum Input {
+    Hover {
+        #[serde(rename = "sessionId")]
+        session_id: String,
+        slot: ActionRingSlot,
+    },
+    Activate {
+        #[serde(rename = "sessionId")]
+        session_id: String,
+        slot: ActionRingSlot,
+    },
+    Cancel {
+        #[serde(rename = "sessionId")]
+        session_id: String,
+    },
+}
+
+#[derive(Serialize)]
+#[serde(tag = "type", rename_all = "lowercase")]
+enum Output<'a> {
+    Hello {
+        version: u32,
+        #[serde(rename = "displayLifetimeMs")]
+        display_lifetime_ms: u64,
+    },
+    Status(&'a Status),
+    Ring {
+        invocation: Option<RingMessage>,
+    },
+    Error {
+        message: String,
+    },
+}
+
+#[derive(Serialize)]
+#[serde(rename_all = "camelCase")]
+pub(crate) struct RingMessage {
+    pub(crate) session_id: String,
+    pub(crate) slots: Vec<SlotMessage>,
+}
+
+#[derive(Serialize)]
+#[serde(rename_all = "camelCase")]
+pub(crate) struct SlotMessage {
+    pub(crate) slot: ActionRingSlot,
+    pub(crate) label: String,
+    pub(crate) icon_svg: String,
+    pub(crate) x: f32,
+    pub(crate) y: f32,
+}
+
+/// What the renderer is told about the agent and the devices it reaches.
+#[derive(Clone, Debug, PartialEq, Eq, Serialize)]
+pub(crate) struct Status {
+    agent: &'static str,
+    inventory: &'static str,
+    devices: Vec<String>,
+}
+
+impl Status {
+    const fn empty(agent: &'static str) -> Self {
+        Self {
+            agent,
+            inventory: "unknown",
+            devices: Vec::new(),
+        }
+    }
+
+    /// Names of the online devices, never receivers or serial numbers.
+    pub(crate) fn of(snapshot: &AgentSnapshot) -> Self {
+        let paired = snapshot.inventory.iter().flat_map(|group| {
+            group
+                .paired
+                .iter()
+                .filter(|device| device.online)
+                .map(|device| device.codename.as_ref().unwrap_or(&group.receiver.name))
+        });
+        let standalone = snapshot
+            .standalone
+            .iter()
+            .filter(|device| device.online)
+            .map(|device| &device.display_name);
+        Self {
+            agent: "connected",
+            inventory: match snapshot.status.inventory {
+                InventoryHealth::Scanning => "scanning",
+                InventoryHealth::Ready => "ready",
+                InventoryHealth::Unavailable => "unavailable",
+            },
+            devices: paired.chain(standalone).cloned().collect(),
+        }
+    }
+}
+
+struct Showing {
+    id: u64,
+    slots: BTreeSet<ActionRingSlot>,
+    until: Instant,
+}
+
+/// The one ring the renderer may interact with, and the last one that ended
+/// here. Routing and timeout only: the actions stay in the agent.
+#[derive(Default)]
+pub(crate) struct Session {
+    showing: Option<Showing>,
+    ended: Option<u64>,
+}
+
+impl Session {
+    /// Show `invocation` from `now`. `false` when there is nothing new to
+    /// present: it is already showing, or it already ended here and a late
+    /// observation must not reopen it.
+    pub(crate) fn show(&mut self, invocation: &ActionRingInvocation, now: Instant) -> bool {
+        let id = invocation.session_id;
+        if self.ended == Some(id) || self.showing.as_ref().is_some_and(|ring| ring.id == id) {
+            return false;
+        }
+        self.forget();
+        self.showing = Some(Showing {
+            id,
+            slots: invocation.slots.keys().copied().collect(),
+            until: now + DISPLAY_LIFETIME,
+        });
+        true
+    }
+
+    /// The agent dismissed the ring; there is nothing to acknowledge.
+    pub(crate) fn forget(&mut self) {
+        if let Some(ring) = self.showing.take() {
+            self.ended = Some(ring.id);
+        }
+    }
+
+    /// End the showing ring on this process's own authority.
+    pub(crate) fn cancel(&mut self) -> Option<OverlayCommand> {
+        let session_id = self.showing.as_ref()?.id;
+        self.forget();
+        Some(OverlayCommand::Cancel { session_id })
+    }
+
+    /// When the showing ring expires.
+    fn deadline(&self) -> Option<Instant> {
+        self.showing.as_ref().map(|ring| ring.until)
+    }
+
+    /// Cancel the showing ring if its display lifetime is over at `now`.
+    pub(crate) fn expire(&mut self, now: Instant) -> Option<OverlayCommand> {
+        if self.deadline().is_some_and(|until| until <= now) {
+            self.cancel()
+        } else {
+            None
+        }
+    }
+
+    /// Turn one renderer line into the command it asks for, or say why not.
+    /// A terminal command ends the session here, so a repeat is refused.
+    pub(crate) fn command(&mut self, line: &str, now: Instant) -> Result<OverlayCommand> {
+        let input: Input = serde_json::from_str(line).context("invalid command")?;
+        let (raw, slot) = match &input {
+            Input::Hover { session_id, slot } | Input::Activate { session_id, slot } => {
+                (session_id, Some(*slot))
+            }
+            Input::Cancel { session_id } => (session_id, None),
+        };
+        let session_id = parse_session_id(raw)?;
+        let ring = self
+            .showing
+            .as_ref()
+            .filter(|ring| ring.id == session_id && now < ring.until)
+            .ok_or_else(|| anyhow!("session {session_id} is not interactive"))?;
+        if let Some(slot) = slot
+            && !ring.slots.contains(&slot)
+        {
+            bail!("slot {slot:?} is empty in session {session_id}");
+        }
+        let command = match input {
+            Input::Hover { slot, .. } => OverlayCommand::Hover { session_id, slot },
+            Input::Activate { slot, .. } => OverlayCommand::Activate { session_id, slot },
+            Input::Cancel { .. } => OverlayCommand::Cancel { session_id },
+        };
+        if command.is_terminal() {
+            self.forget();
+        }
+        Ok(command)
+    }
+}
+
+fn parse_session_id(raw: &str) -> Result<u64> {
+    if raw.is_empty() || !raw.bytes().all(|byte| byte.is_ascii_digit()) {
+        bail!("sessionId must be a decimal string");
+    }
+    match raw.parse() {
+        Ok(0) | Err(_) => bail!("sessionId is out of range"),
+        Ok(id) => Ok(id),
+    }
+}
+
+/// The presentation the renderer draws, localized and with embedded glyphs.
+pub(crate) fn ring_message(invocation: &ActionRingInvocation) -> Result<RingMessage> {
+    openlogi_core::locale::activate(invocation.language.as_deref());
+    let mut slots = Vec::with_capacity(invocation.slots.len());
+    for slot in ActionRingSlot::ALL {
+        let Some(presentation) = invocation.slots.get(&slot) else {
+            continue;
+        };
+        let path = presentation.icon.asset_path();
+        let icon = ActionIcons
+            .load(path)?
+            .ok_or_else(|| anyhow!("embedded icon {path} is missing"))?;
+        let (x, y) = slot.placement(WINDOW_SIZE, RADIUS, SLOT_SIZE);
+        slots.push(SlotMessage {
+            slot,
+            label: presentation_label(presentation),
+            icon_svg: String::from_utf8(icon.into_owned()).context("icon is not UTF-8")?,
+            x,
+            y,
+        });
+    }
+    Ok(RingMessage {
+        session_id: invocation.session_id.to_string(),
+        slots,
+    })
+}
+
+enum Line {
+    Text(String),
+    NotUtf8,
+    TooLong,
+}
+
+/// Feed stdin to `lines` one bounded line at a time. Closing the channel is
+/// end of input.
+async fn read_lines(input: pipe::Receiver, lines: mpsc::Sender<Line>) {
+    let mut reader = BufReader::with_capacity(MAX_LINE, input);
+    loop {
+        let line = match read_line(&mut reader).await {
+            Ok(Some(line)) => line,
+            Ok(None) => return,
+            Err(error) => {
+                warn!(%error, "stdin failed");
+                return;
+            }
+        };
+        let fatal = matches!(line, Line::TooLong);
+        if lines.send(line).await.is_err() || fatal {
+            return;
+        }
+    }
+}
+
+async fn read_line(reader: &mut BufReader<pipe::Receiver>) -> std::io::Result<Option<Line>> {
+    let mut line = Vec::new();
+    loop {
+        let available = reader.fill_buf().await?;
+        if available.is_empty() {
+            return Ok((!line.is_empty()).then(|| text(line)));
+        }
+        let newline = available.iter().position(|byte| *byte == b'\n');
+        let content = newline.unwrap_or(available.len());
+        if line.len() + content > MAX_LINE {
+            return Ok(Some(Line::TooLong));
+        }
+        line.extend_from_slice(&available[..content]);
+        reader.consume(newline.map_or(content, |index| index + 1));
+        if newline.is_some() {
+            return Ok(Some(text(line)));
+        }
+    }
+}
+
+fn text(bytes: Vec<u8>) -> Line {
+    String::from_utf8(bytes).map_or(Line::NotUtf8, Line::Text)
+}
+
+enum Event {
+    Ring(Option<ActionRingInvocation>),
+    Status(Status),
+    Ended(LinkFailure),
+}
+
+async fn watch_ring(events: mpsc::Sender<Event>) {
+    loop {
+        match ipc::connect_checked().await {
+            Ok(client) => {
+                let mut observer = Observer::action_ring(client);
+                while let Ok(answer) = observer.next().await {
+                    if let Some(ring) = answer
+                        && events.send(Event::Ring(ring.invocation)).await.is_err()
+                    {
+                        return;
+                    }
+                }
+                // A ring from a lost connection can no longer be answered.
+                if events.send(Event::Ring(None)).await.is_err() {
+                    return;
+                }
+            }
+            Err(LinkFailure::Unreachable) => {}
+            Err(failure) => {
+                let _ = events.send(Event::Ended(failure)).await;
+                return;
+            }
+        }
+        tokio::time::sleep(RETRY_PERIOD).await;
+    }
+}
+
+async fn watch_status(events: mpsc::Sender<Event>) {
+    loop {
+        match ipc::connect_checked().await {
+            Ok(client) => {
+                if events
+                    .send(Event::Status(Status::empty("connected")))
+                    .await
+                    .is_err()
+                {
+                    return;
+                }
+                let mut observer = Observer::state(client);
+                while let Ok(answer) = observer.next().await {
+                    if let Some(observation) = answer
+                        && events
+                            .send(Event::Status(Status::of(&observation.snapshot)))
+                            .await
+                            .is_err()
+                    {
+                        return;
+                    }
+                }
+            }
+            Err(LinkFailure::Unreachable) => {}
+            Err(failure) => {
+                let _ = events.send(Event::Ended(failure)).await;
+                return;
+            }
+        }
+        if events
+            .send(Event::Status(Status::empty("unavailable")))
+            .await
+            .is_err()
+        {
+            return;
+        }
+        tokio::time::sleep(RETRY_PERIOD).await;
+    }
+}
+
+/// How a bridge run ended without an error of its own.
+enum Exit {
+    EndOfInput,
+    Terminated,
+    Superseded(String),
+}
+
+struct Bridge {
+    stdout: pipe::Sender,
+    commands: mpsc::UnboundedSender<OverlayCommand>,
+    session: Session,
+    status: Option<Status>,
+    /// The last terminal command handed to the worker, awaited at shutdown.
+    last_terminal: Option<OverlayCommand>,
+}
+
+impl Bridge {
+    async fn write(&mut self, output: &Output<'_>) -> Result<()> {
+        let mut line = serde_json::to_vec(output)?;
+        line.push(b'\n');
+        tokio::time::timeout(PIPE_DEADLINE, self.stdout.write_all(&line))
+            .await
+            .context("stdout stalled")?
+            .context("stdout closed")
+    }
+
+    async fn error(&mut self, message: String) -> Result<()> {
+        self.write(&Output::Error { message }).await
+    }
+
+    async fn closed(&mut self) -> Result<()> {
+        self.write(&Output::Ring { invocation: None }).await
+    }
+
+    async fn status(&mut self, status: Status) -> Result<()> {
+        if self.status.as_ref() == Some(&status) {
+            return Ok(());
+        }
+        self.write(&Output::Status(&status)).await?;
+        self.status = Some(status);
+        Ok(())
+    }
+
+    fn send(&mut self, command: OverlayCommand) -> Result<()> {
+        if command.is_terminal() {
+            self.last_terminal = Some(command);
+        }
+        self.commands
+            .send(command)
+            .map_err(|_| anyhow!("the command worker stopped"))
+    }
+
+    async fn line(&mut self, line: Line) -> Result<()> {
+        let parsed = match line {
+            Line::Text(line) => self.session.command(&line, Instant::now()),
+            Line::NotUtf8 => Err(anyhow!("command is not UTF-8")),
+            Line::TooLong => {
+                self.error(format!("command exceeds {MAX_LINE} bytes"))
+                    .await?;
+                bail!("command exceeds {MAX_LINE} bytes");
+            }
+        };
+        match parsed {
+            Ok(command) => {
+                self.send(command)?;
+                if command.is_terminal() {
+                    self.closed().await?;
+                }
+                Ok(())
+            }
+            Err(error) => self.error(format!("{error:#}")).await,
+        }
+    }
+
+    async fn event(&mut self, event: Event) -> Result<Option<Exit>> {
+        match event {
+            Event::Ring(Some(invocation)) => {
+                if !self.session.show(&invocation, Instant::now()) {
+                    return Ok(None);
+                }
+                match ring_message(&invocation) {
+                    Ok(ring) => {
+                        self.write(&Output::Ring {
+                            invocation: Some(ring),
+                        })
+                        .await?;
+                    }
+                    Err(error) => {
+                        if let Some(command) = self.session.cancel() {
+                            self.send(command)?;
+                        }
+                        self.error(format!("could not present the Actions Ring: {error:#}"))
+                            .await?;
+                    }
+                }
+            }
+            Event::Ring(None) => {
+                self.session.forget();
+                self.closed().await?;
+            }
+            Event::Status(status) => self.status(status).await?,
+            Event::Ended(LinkFailure::Incompatible(because)) => {
+                self.status(Status::empty("incompatible")).await?;
+                self.error(because.clone()).await?;
+                bail!("the agent is incompatible: {because}");
+            }
+            Event::Ended(LinkFailure::Superseded(because)) => {
+                self.session.forget();
+                self.closed().await?;
+                self.error(because.clone()).await?;
+                return Ok(Some(Exit::Superseded(because)));
+            }
+            Event::Ended(LinkFailure::Unreachable) => {}
+        }
+        Ok(None)
+    }
+
+    async fn run(
+        &mut self,
+        lines: &mut mpsc::Receiver<Line>,
+        events: &mut mpsc::Receiver<Event>,
+    ) -> Result<Exit> {
+        let mut terminate = signal(SignalKind::terminate())?;
+        self.write(&Output::Hello {
+            version: PROTOCOL,
+            display_lifetime_ms: u64::try_from(DISPLAY_LIFETIME.as_millis())?,
+        })
+        .await?;
+        self.status(Status::empty("connecting")).await?;
+        // A closed stdout has no read-side notification while the agent is
+        // idle. A small status heartbeat also bounds teardown if the parent
+        // closes its read end without closing stdin.
+        let mut heartbeat = tokio::time::interval(Duration::from_secs(1));
+        heartbeat.tick().await;
+        loop {
+            let deadline = self.session.deadline();
+            tokio::select! {
+                _ = heartbeat.tick() => {
+                    if let Some(status) = self.status.clone() {
+                        self.write(&Output::Status(&status)).await?;
+                    }
+                }
+                () = until(deadline) => {
+                    if let Some(command) = self.session.expire(Instant::now()) {
+                        self.send(command)?;
+                        self.closed().await?;
+                    }
+                }
+                _ = terminate.recv() => return Ok(Exit::Terminated),
+                line = lines.recv() => match line {
+                    Some(line) => self.line(line).await?,
+                    None => return Ok(Exit::EndOfInput),
+                },
+                event = events.recv() => {
+                    let event = event.context("the agent observers stopped")?;
+                    if let Some(exit) = self.event(event).await? {
+                        return Ok(exit);
+                    }
+                }
+            }
+        }
+    }
+}
+
+async fn until(deadline: Option<Instant>) {
+    match deadline {
+        Some(deadline) => tokio::time::sleep_until(deadline.into()).await,
+        None => std::future::pending().await,
+    }
+}
+
+async fn serve() -> Result<()> {
+    let input = pipe::Receiver::from_owned_fd(std::io::stdin().as_fd().try_clone_to_owned()?)
+        .context("stdin must be a pipe")?;
+    let stdout = pipe::Sender::from_owned_fd(std::io::stdout().as_fd().try_clone_to_owned()?)
+        .context("stdout must be a pipe")?;
+
+    let (line_tx, mut lines) = mpsc::channel(8);
+    let (event_tx, mut events) = mpsc::channel(8);
+    let (commands, mut command_rx) = mpsc::unbounded_channel();
+    let (delivered_tx, mut delivered) = watch::channel(None);
+    let reader = tokio::spawn(read_lines(input, line_tx));
+    let rings = tokio::spawn(watch_ring(event_tx.clone()));
+    let states = tokio::spawn(watch_status(event_tx));
+    let worker = tokio::spawn(async move {
+        ipc::send_commands_reporting(&mut command_rx, Arc::new(delivered_tx)).await;
+    });
+
+    let mut bridge = Bridge {
+        stdout,
+        commands,
+        session: Session::default(),
+        status: None,
+        last_terminal: None,
+    };
+    let outcome = bridge.run(&mut lines, &mut events).await;
+    reader.abort();
+    rings.abort();
+    states.abort();
+
+    // The worker gives up a command in flight the moment its channel closes,
+    // so the sender stays alive until the last terminal command is delivered
+    // or the deadline passes.
+    if let Some(command) = bridge.session.cancel() {
+        let _ = bridge.send(command);
+    }
+    if let Some(last) = bridge.last_terminal {
+        let delivered = delivered.wait_for(|sent| *sent == Some(last));
+        if tokio::time::timeout(PIPE_DEADLINE, delivered)
+            .await
+            .is_err()
+        {
+            warn!("the agent did not confirm the last Actions Ring command before exit");
+        }
+    }
+    drop(bridge);
+    worker.abort();
+
+    match outcome? {
+        Exit::EndOfInput => info!("stdin closed — leaving the Actions Ring bridge"),
+        Exit::Terminated => info!("terminated — leaving the Actions Ring bridge"),
+        Exit::Superseded(because) => info!("{because} — leaving the Actions Ring bridge"),
+    }
+    Ok(())
+}
+
+/// Serve the ring over stdin/stdout until the parent closes stdin, sends
+/// SIGTERM, stops reading, or the agent is replaced.
+pub(crate) fn run() -> Result<()> {
+    // Declared first so it drops last: observers and the command worker stop
+    // with the runtime before the role is released.
+    let _tenancy = crate::session::claim_the_role()?;
+    let runtime = openlogi_core::worker::runtime()?;
+    runtime.block_on(serve())
+}
