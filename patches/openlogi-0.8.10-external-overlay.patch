+#[cfg(target_os = "linux")]
+mod stdio {
+    use std::collections::BTreeMap;
+    use std::time::Instant;
+
+    use openlogi_core::action_ring::DISPLAY_LIFETIME;
+    use openlogi_core::binding::{ActionRingIcon, ActionRingSlot};
+    use openlogi_ipc::{ActionRingInvocation, ActionRingPresentation};
+
+    use crate::ipc::OverlayCommand;
+    use crate::ring::{RADIUS, SLOT_SIZE, WINDOW_SIZE};
+    use crate::stdio::{Session, ring_message};
+
+    /// Above 2^53, where a JavaScript number would round it to a neighbour.
+    const BIG: u64 = 9_007_199_254_740_993;
+
+    fn invocation(session_id: u64, slots: &[ActionRingSlot]) -> ActionRingInvocation {
+        ActionRingInvocation {
+            session_id,
+            slots: slots
+                .iter()
+                .map(|slot| {
+                    (
+                        *slot,
+                        ActionRingPresentation {
+                            label: "Copy".into(),
+                            literal: true,
+                            icon: ActionRingIcon::Copy,
+                        },
+                    )
+                })
+                .collect::<BTreeMap<_, _>>(),
+            language: None,
+        }
+    }
+
+    fn showing(session_id: u64, slots: &[ActionRingSlot]) -> (Session, Instant) {
+        let now = Instant::now();
+        let mut session = Session::default();
+        assert!(session.show(&invocation(session_id, slots), now));
+        (session, now)
+    }
+
+    #[test]
+    fn a_session_id_above_2_pow_53_reaches_the_agent_intact() {
+        let (mut session, now) = showing(BIG, &[ActionRingSlot::Top]);
+        let command = session
+            .command(
+                r#"{"type":"activate","sessionId":"9007199254740993","slot":"Top"}"#,
+                now,
+            )
+            .unwrap();
+        assert_eq!(
+            command,
+            OverlayCommand::Activate {
+                session_id: BIG,
+                slot: ActionRingSlot::Top
+            }
+        );
+    }
+
+    #[test]
+    fn a_cancel_for_a_replaced_session_leaves_its_successor_open() {
+        let (mut session, now) = showing(17, &[ActionRingSlot::Top]);
+        assert!(session.show(&invocation(18, &[ActionRingSlot::Top]), now));
+        let stale = session.command(r#"{"type":"cancel","sessionId":"17"}"#, now);
+        assert!(stale.is_err(), "cancelling A must not reach B");
+        let hover = session
+            .command(r#"{"type":"hover","sessionId":"18","slot":"Top"}"#, now)
+            .unwrap();
+        assert_eq!(
+            hover,
+            OverlayCommand::Hover {
+                session_id: 18,
+                slot: ActionRingSlot::Top
+            }
+        );
+    }
+
+    #[test]
+    fn a_repeated_activation_delivers_one_action() {
+        let (mut session, now) = showing(17, &[ActionRingSlot::Top]);
+        let activate = r#"{"type":"activate","sessionId":"17","slot":"Top"}"#;
+        session.command(activate, now).unwrap();
+        assert!(
+            session.command(activate, now).is_err(),
+            "duplicate activation"
+        );
+        let late_hover = session.command(r#"{"type":"hover","sessionId":"17","slot":"Top"}"#, now);
+        assert!(late_hover.is_err(), "hover after the terminal command");
+        assert_eq!(session.cancel(), None);
+    }
+
+    #[test]
+    fn malformed_commands_deliver_nothing_and_keep_the_ring_open() {
+        let (mut session, now) = showing(17, &[ActionRingSlot::Top]);
+        for line in [
+            "not json",
+            r#"{"type":"activate","sessionId":"17","slot":"Middle"}"#,
+            r#"{"type":"activate","sessionId":"17","slot":"Right"}"#,
+            r#"{"type":"activate","sessionId":17,"slot":"Top"}"#,
+            r#"{"type":"activate","sessionId":"+17","slot":"Top"}"#,
+            r#"{"type":"activate","sessionId":"0","slot":"Top"}"#,
+            r#"{"type":"activate","sessionId":"18446744073709551616","slot":"Top"}"#,
+            r#"{"type":"activate","sessionId":"17","slot":"Top","action":"x"}"#,
+            r#"{"type":"cancel","sessionId":"17","slot":"Top"}"#,
+            r#"{"type":"launch","sessionId":"17"}"#,
+        ] {
+            assert!(session.command(line, now).is_err(), "accepted {line}");
+        }
+        session
+            .command(r#"{"type":"cancel","sessionId":"17"}"#, now)
+            .unwrap();
+    }
+
+    #[test]
+    fn an_expired_ring_is_cancelled_once_and_then_refuses_commands() {
+        let (mut session, now) = showing(17, &[ActionRingSlot::Top]);
+        assert_eq!(session.expire(now), None);
+        let later = now + DISPLAY_LIFETIME;
+        assert_eq!(
+            session.expire(later),
+            Some(OverlayCommand::Cancel { session_id: 17 })
+        );
+        assert_eq!(session.expire(later), None);
+        let late = session.command(
+            r#"{"type":"activate","sessionId":"17","slot":"Top"}"#,
+            later,
+        );
+        late.unwrap_err();
+    }
+
+    #[test]
+    fn a_late_observation_does_not_reopen_an_ended_ring() {
+        let (mut session, now) = showing(17, &[ActionRingSlot::Top]);
+        assert!(!session.show(&invocation(17, &[ActionRingSlot::Top]), now));
+        session
+            .command(r#"{"type":"cancel","sessionId":"17"}"#, now)
+            .unwrap();
+        assert!(!session.show(&invocation(17, &[ActionRingSlot::Top]), now));
+        assert!(session.show(&invocation(18, &[]), now));
+    }
+
+    #[test]
+    fn the_ring_message_keeps_display_order_ids_and_literal_labels() {
+        let ring = ring_message(&invocation(
+            BIG,
+            &[ActionRingSlot::Left, ActionRingSlot::Top],
+        ))
+        .unwrap();
+        let value = serde_json::to_value(&ring).unwrap();
+        assert_eq!(value["sessionId"], "9007199254740993");
+        assert_eq!(value["slots"][0]["slot"], "Top");
+        assert_eq!(value["slots"][1]["slot"], "Left");
+        assert_eq!(value["slots"][0]["label"], "Copy");
+        assert!(
+            value["slots"][0]["iconSvg"]
+                .as_str()
+                .unwrap()
+                .contains("<svg")
+        );
+        let (x, y) = ActionRingSlot::Left.placement(WINDOW_SIZE, RADIUS, SLOT_SIZE);
+        assert_eq!(value["slots"][1]["x"], serde_json::json!(x));
+        assert_eq!(value["slots"][1]["y"], serde_json::json!(y));
+    }
+}
